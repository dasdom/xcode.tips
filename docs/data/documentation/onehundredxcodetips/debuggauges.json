{"abstract":[{"type":"text","text":"See important metrics of your app while debugging."}],"metadata":{"role":"article","modules":[{"name":"OneHundredXcodeTips"}],"roleHeading":"Article","title":"Debug Gauges"},"sections":[],"identifier":{"url":"doc:\/\/onehundredxcodetips.OneHundredXcodeTips\/documentation\/OneHundredXcodeTips\/DebugGauges","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"tl;dr","anchor":"tldr"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"debug_gauge_memory"}]},{"type":"thematicBreak"},{"type":"heading","text":"Use Cases","level":2,"anchor":"Use-Cases"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Keep an eye on memory usage, cpu, network and disk access of your app while debugging"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Become aware of a memory leak before opening Instruments"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Hand over the running debug session to Instruments to investigate further","type":"text"}]}]}]},{"type":"heading","text":"Debug Gauges","anchor":"Debug-Gauges","level":2},{"columns":[{"content":[{"inlineContent":[{"text":"While you app is running and the debugger is attached, select the debug navigator (","type":"text"},{"inlineContent":[{"code":"⌘7","type":"codeVoice"}],"type":"strong"},{"text":") and click on one of the debug gauges.","type":"text"}],"type":"paragraph"}],"size":1},{"content":[{"inlineContent":[{"type":"image","identifier":"debug_gauge_memory"}],"type":"paragraph"}],"size":1}],"numberOfColumns":2,"type":"row"},{"columns":[{"size":1,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need to investigate a problem you see in the debug gauges, click the ‘Profile in Instruments’ button in the upper right."},{"type":"text","text":" "},{"type":"text","text":"Xcode opens Instruments with a context fitting configuration and passes the already recorded data to the Instruments session."},{"text":" ","type":"text"},{"text":"You can collect more data for the debug session that raised your suspicion.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"This way the chance of finding the cause of the issue is highly increased."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"profile_debug_session","type":"image"}]}],"size":1}],"type":"row","numberOfColumns":2},{"anchor":"Xcodetips","text":"Xcode.tips","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/xcode.tips\/debug-gaubes\/","isActive":true,"type":"reference"}]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/onehundredxcodetips.OneHundredXcodeTips\/documentation\/OneHundredXcodeTips"]]},"variants":[{"paths":["\/documentation\/onehundredxcodetips\/debuggauges"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://onehundredxcodetips.OneHundredXcodeTips/documentation/OneHundredXcodeTips":{"role":"collection","identifier":"doc:\/\/onehundredxcodetips.OneHundredXcodeTips\/documentation\/OneHundredXcodeTips","url":"\/documentation\/onehundredxcodetips","abstract":[],"type":"topic","kind":"symbol","title":"OneHundredXcodeTips"},"debug_gauge_memory":{"alt":null,"identifier":"debug_gauge_memory","variants":[{"traits":["1x","light"],"url":"\/images\/onehundredxcodetips.OneHundredXcodeTips\/debug_gauge_memory.png"},{"url":"\/images\/onehundredxcodetips.OneHundredXcodeTips\/debug_gauge_memory~dark.png","traits":["1x","dark"]}],"type":"image"},"https://xcode.tips/assets/32_debug_gauges.jpg":{"alt":"Xcode.tips: Debug Gauges","identifier":"https:\/\/xcode.tips\/assets\/32_debug_gauges.jpg","type":"image","variants":[{"url":"https:\/\/xcode.tips\/assets\/32_debug_gauges.jpg","traits":["1x","light"]}]},"profile_debug_session":{"type":"image","alt":null,"variants":[{"traits":["1x","lig