ype":"strong","inlineContent":[{"type":"codeVoice","code":"⌘1"}]}],"type":"paragraph"}],"type":"aside","name":"Tip"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The project navigator provides an overview over all the files and folders in your project."}]},{"type":"row","numberOfColumns":2,"columns":[{"size":1,"content":[{"type":"paragraph","inlineContent":[{"text":"A secondary click opens a context menu with options to open a file in different places, add files and folders, set bookmarks and more.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"project_navigator_context_menu","type":"image"}]}],"size":1}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"At the bottom of the project navigator is a filter textfield to filter the shown files."},{"text":" ","type":"text"},{"text":"The filter textfield also provides buttons for only showing recently changed files and\/or files with a source control status.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"project_navigator_filter_textfield"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plus button next to the filter textfield is for adding files and folders to the project."}]}],"title":"Project"},{"title":"Source Control","content":[{"text":"Source Control Navigator","anchor":"Source-Control-Navigator","level":3,"type":"heading"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"⌘2"}]}]}],"name":"Tip","style":"tip"},{"inlineContent":[{"text":"Whenever a file is added, changed, moved or deleted its source-control status changes.","type":"text"},{"type":"text","text":" "},{"text":"In the Changes tab of the source control navigator Xcodes lists all files with a source control status.","type":"text"},{"text":" ","type":"text"},{"text":"The symbols on the right indicate the type of the status.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A secondary click on one of the files opens a context menu with options to stage, unstage, discard changes and more.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use the filter textfield at the bottom of the source control navigator to filter the shown files."}],"type":"paragraph"},{"inlineContent":[{"text":"Open the Repositories tab to access the repositories of the project and all it’s meta data like branches, tags, remotes and such.","type":"text"}],"type":"paragraph"},{"type":"row","numberOfColumns":2,"columns":[{"size":1,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Next to the filter textfield is a button for global actions for all files with version control status like “Discard All Changes”, “Stash Changes” and more."}]}]},{"content":[{"inlineContent":[{"type":"image","identifier":"source_control_global_actions"}],"type":"paragraph"}],"size":1}]}]},{"title":"Bookmark","content":[{"text":"Bookmark Navigator","level":3,"type":"heading","anchor":"Bookmark-Navigator"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"⌘3"}]}]}],"type":"aside","style":"tip","name":"Tip"},{"type":"paragraph","inlineContent":[{"text":"Your bookmarks are listed here.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"You can add file, line and search bookmarks."}]},{"numberOfColumns":2,"type":"row","columns":[{"size":1,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Next to the bookmark is an indicator if the bookmark is checked."},{"text":" ","type":"text"},{"type":"text","text":"So you can use the bookmark feature as a to-do list."}]}]},{"size":1,"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"bookmarks_navigator"}]}]}]},{"text":"See also","type":"heading","anchor":"See-also","level":3},{"type":"paragraph","inlineContent":[{