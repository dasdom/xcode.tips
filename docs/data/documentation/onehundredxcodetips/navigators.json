inlineContent":[{"text":"","type":"text"},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"⌘1"}]}]}],"style":"tip","type":"aside","name":"Tip"},{"inlineContent":[{"text":"The project navigator provides an overview over all the files and folders in your project.","type":"text"}],"type":"paragraph"},{"type":"row","numberOfColumns":2,"columns":[{"size":1,"content":[{"type":"paragraph","inlineContent":[{"text":"A secondary click opens a context menu with options to open a file in different places, add files and folders, set bookmarks and more.","type":"text"}]}]},{"size":1,"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"project_navigator_context_menu"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"At the bottom of the project navigator is a filter textfield to filter the shown files."},{"type":"text","text":" "},{"text":"The filter textfield also provides buttons for only showing recently changed files and\/or files with a source control status.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"project_navigator_filter_textfield","type":"image"}]},{"type":"paragraph","inlineContent":[{"text":"The plus button next to the filter textfield is for adding files and folders to the project.","type":"text"}]}]},{"title":"Source Control","content":[{"text":"Source Control Navigator","anchor":"Source-Control-Navigator","level":3,"type":"heading"},{"name":"Tip","type":"aside","style":"tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"strong","inlineContent":[{"code":"⌘2","type":"codeVoice"}]}]}]},{"inlineContent":[{"text":"Whenever a file is added, changed, moved or deleted its source-control status changes.","type":"text"},{"type":"text","text":" "},{"text":"In the Changes tab of the source control navigator Xcodes lists all files with a source control status.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The symbols on the right indicate the type of the status."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"A secondary click on one of the files opens a context menu with options to stage, unstage, discard changes and more.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Use the filter textfield at the bottom of the source control navigator to filter the shown files."}],"type":"paragraph"},{"inlineContent":[{"text":"Open the Repositories tab to access the repositories of the project and all it’s meta data like branches, tags, remotes and such.","type":"text"}],"type":"paragraph"},{"numberOfColumns":2,"type":"row","columns":[{"content":[{"inlineContent":[{"type":"text","text":"Next to the filter textfield is a button for global actions for all files with version control status like “Discard All Changes”, “Stash Changes” and more."}],"type":"paragraph"}],"size":1},{"size":1,"content":[{"type":"paragraph","inlineContent":[{"identifier":"source_control_global_actions","type":"image"}]}]}]}]},{"content":[{"text":"Bookmark Navigator","type":"heading","level":3,"anchor":"Bookmark-Navigator"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"inlineContent":[{"type":"codeVoice","code":"⌘3"}],"type":"strong"}]}],"name":"Tip","style":"tip","type":"aside"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your bookmarks are listed here."},{"text":" ","type":"text"},{"type":"text","text":"You can add file, line and search bookmarks."}]},{"numberOfColumns":2,"columns":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Next to the bookmark is an indicator if the bookmark is checked.","type":"text"},{"type":"text","text":" "},{"text":"So you can use the bookmark feature as a to-do list.","type":"text"}]}],"size":1},{"size":1,"content":[{"type":"paragraph","inlineContent":[{"identifier":"bookmarks_navigator","type":"image"}]}]}],"type":"row"},{"level":3,"type":"heading","text":"See also","anchor":"See-also"},{"inlineContent":[{"identifier":"do